<%- include('partials/head', { title }) %>
<h1>Prijava</h1>
<div class="form narrow">
  <% if (googleUkljucen) { %>
    <a class="btn" href="/auth/google?povratak=<%= encodeURIComponent(povratak) %>">Prijava putem Googlea</a>
    <p class="note">Prijavljujete se Google računom (OpenID Connect). Ako još nemate račun u StormWatchu, otvorit će se automatski.</p>
  <% } else { %>
    <p class="note">Prijava putem Googlea trenutno nije postavljena na poslužitelju.</p>
  <% } %>
</div>
<% if (demoKorisnici) { %>
  <form method="post" action="/prijava/demo" class="form narrow">
    <h2>Brza prijava (samo lokalni razvoj)</h2>
    <input type="hidden" name="povratak" value="<%= povratak %>">
    <label>Korisnik
      <select name="korisnikId"><% demoKorisnici.forEach(k => { %><option value="<%= k.id %>"><%= k.korisnicko_ime %> (<%= k.uloga %>)</option><% }) %></select>
    </label>
    <button class="btn ghost">Prijavi se kao odabrani korisnik</button>
  </form>
<% } %>
<%- include('partials/foot') %>
