<%- include('partials/head', { title }) %>
<div class="row"><h1>Prijave</h1><a class="btn" href="/prijave/nova">Nova prijava</a></div>
<form class="filters" method="get">
  <label>Vrsta pojave
    <select name="vrsta" onchange="this.form.submit()">
      <option value="">Sve</option>
      <% ['Tuča','Olujni vjetar','Jaka kiša i poplava','Snijeg','Poledica','Pijavica'].forEach(v => { %><option <%= vrste === v ? 'selected' : '' %>><%= v %></option><% }) %>
    </select>
  </label>
</form>
<ul class="reports">
  <% prijave.filter(p => !vrste || p.vrsta === vrste).forEach(p => { %>
    <li class="report <%= p.status === 'potvrđena' ? 'confirmed' : '' %>">
      <div class="row">
        <h2><%= p.vrsta %>, <%= p.mjesto %></h2>
        <span class="badge"><%= p.status %></span>
      </div>
      <p><%= p.opis %></p>
      <p class="meta"><%= p.vrijeme %> · <%= p.autor %><% if (p.pouzdan) { %> <span class="badge trusted">pouzdani motritelj</span><% } %> · <%= p.intenzitet %></p>
      <div class="row">
        <div class="cred" title="Vjerodostojnost <%= p.vjerodostojnost %> %"><span style="width:<%= p.vjerodostojnost %>%"></span></div>
        <span class="meta">I ja to vidim: <%= p.potvrde %> · Kod mene nije tako: <%= p.osporavanja %></span>
        <% if (p.dogadaj) { %><a href="/dogadaji/<%= p.dogadaj %>">Stranica događaja</a><% } %>
      </div>
    </li>
  <% }) %>
</ul>
<%- include('partials/foot') %>
