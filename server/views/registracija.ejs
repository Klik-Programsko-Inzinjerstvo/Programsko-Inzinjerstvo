<%- include('partials/head', { title }) %>
<h1>Registracija</h1>
<form method="post" action="/registracija" class="form narrow">
  <label>Korisničko ime <input name="korisnik" required></label>
  <label>E-pošta <input type="email" name="email" required autocomplete="email"></label>
  <label>Lozinka <input type="password" name="lozinka" minlength="8" required autocomplete="new-password"></label>
  <button class="btn">Otvori račun</button>
</form>
<%- include('partials/foot') %>
