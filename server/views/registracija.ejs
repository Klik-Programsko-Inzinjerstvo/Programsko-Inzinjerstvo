<%- include('partials/head', { title }) %>
<h1>Registracija</h1>
<div class="form narrow">
  <p>Račun se otvara Google računom. Pri prvoj prijavi StormWatch preuzima vašu potvrđenu adresu e-pošte, ime i sliku profila. Lozinku ne spremamo.</p>
  <% if (googleUkljucen) { %>
    <a class="btn" href="/auth/google">Registracija putem Googlea</a>
  <% } else { %>
    <p class="note">Prijava putem Googlea trenutno nije postavljena na poslužitelju.</p>
  <% } %>
</div>
<%- include('partials/foot') %>
