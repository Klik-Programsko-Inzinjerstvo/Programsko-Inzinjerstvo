<%- include('partials/head', { title }) %>
<h1>Prognoza</h1>
<div class="cards">
  <% prognoza.forEach(d => { %>
    <article class="card"><h2><%= d.dan %></h2><p class="big"><%= d.ikona %> <%= d.max %>° <small>/ <%= d.min %>°</small></p><p><%= d.opis %></p></article>
  <% }) %>
</div>
<h2>Aktivna upozorenja po regijama</h2>
<ul class="plain">
  <% upozorenja.forEach(u => { %><li class="warn lvl-<%= u.razina %>"><strong><%= u.regija %></strong> <span><%= u.pojava %>, do <%= u.vrijediDo %></span></li><% }) %>
</ul>
<%- include('partials/foot') %>
