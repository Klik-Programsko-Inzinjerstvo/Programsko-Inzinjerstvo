# Kopiraj u backend/.env i upiši vrijednosti. Datoteka .env se ne commita.

# Adresa PostgreSQL baze (Supabase: Connect -> Session pooler). Može biti i u database/.env.
DATABASE_URL=postgresql://korisnik:lozinka@host:5432/postgres

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dugi nasumični niz za potpisivanje kolačića sesije (u produkciji obavezno)
SESSION_SECRET=

# Neobavezno: Cloudinary -> Settings -> API Keys -> "API environment variable".
# Bez toga se prijave spremaju bez fotografija.
CLOUDINARY_URL=

# Samo lokalno: brza prijava kao bilo koji korisnik iz baze, bez Googlea (za isprobavanje uloga)
DEMO_PRIJAVA=true

# Neobavezno
# PORT=3000
# DHMZ_UVOZ=false          # isključi periodičko preuzimanje s DHMZ-a
# DHMZ_INTERVAL_MIN=30
